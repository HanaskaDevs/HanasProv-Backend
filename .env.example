APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:hgYydo91JMCuAHCAvxZDVBJLMYZ4PgiscpNQym6fm5o=
APP_DEBUG=true
APP_URL=http://localhost

# URL del frontend: la usan los correos para armar sus enlaces
# (config/app.php -> frontend_url). Si queda vacío se usa localhost:5173.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=8

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv
DB_HOST=xx.xxx.xx.xx
DB_PORT=1433
DB_DATABASE=Portal_Proveedores
DB_USERNAME=xx
DB_PASSWORD=xxxx

DB_BC_CONNECTION=sqlsrv
DB_BC_HOST=xx.xxx.xx.xxx
DB_BC_PORT=1433
DB_BC_DATABASE=RAW_BC
DB_BC_USERNAME=xxxx
DB_BC_PASSWORD=xxxx

# SIGH (192.168.1.135) — SOLO LECTURA. Usada por
# SincronizarEstadosSighCommand para reflejar en vivo En_Recepcion/Recibido
# en el calendario de horarios de entrega (ver HorarioEntregaService).
DB_SIGH_CONNECTION=sqlsrv_sigh
DB_SIGH_HOST=192.168.1.135
DB_SIGH_PORT=1433
DB_SIGH_DATABASE=SIGH
DB_SIGH_USERNAME=xxxx
DB_SIGH_PASSWORD=xxxx

# Calendario de horarios de entrega: correo que recibe la solicitud de
# aprobación cuando un horario cae en Rechazado y el Guardia igual pide
# registrar el arribo. En pruebas apunta a iflores@hanaska.com; cuando se
# confirme el correo real de Valeria, cambiar SOLO esta variable.
PORTAL_EMAIL_APROBACION_ARRIBO=iflores@hanaska.com
PORTAL_MINUTOS_ATRASADO_A_RECHAZADO=30

# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Asistente Hana - API de Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=600
ASISTENTE_LIMITE_SEMANAL_USD=5
ASISTENTE_LIMITE_MENSUAL_USD=20

# Alertas de recepciones entregadas sin calificar
PORTAL_ALERTAS_RECEPCION=
PORTAL_HORAS_ALERTA_RECEPCION=1

# Sirve los videos/imagenes del home y login por PHP en vez del symlink
# estatico. false por defecto: con "artisan serve" (un solo proceso) pasar por
# PHP hace que cada archivo bloquee al resto de la pagina.
MEDIA_POR_PHP=false

# Orígenes que pueden llamar a la API desde un navegador (separados por coma).
# Debe incluir la URL del frontend y, si se usa la app Android, los orígenes
# de Capacitor (http://localhost y capacitor://localhost).
CORS_ORIGENES_PERMITIDOS=http://localhost:5173,http://localhost,capacitor://localhost

# Vigencia del token de sesión, en minutos. 1440 = 24 horas.
SANCTUM_EXPIRATION=1440
